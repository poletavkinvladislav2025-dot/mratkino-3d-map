  <tag k="description" v="Большая уральская тропа — это межрегиональная всесезонная туристическая тропа протяженностью более 2500 км (по проекту). Основной трек идёт через Пермский край, Свердловскую и Челябинскую области, республику Башкортостан и Оренбуржье."/>
  <tag k="distance" v="2500 km"/>
  <tag k="foot" v="yes"/>
  <tag k="name" v="Большая уральская тропа"/>
  <tag k="name:en" v="Great Ural Trail"/>
  <tag k="network" v="nwn"/>
  <tag k="operator" v="https://vk.com/greaturaltrail_gut"/>
  <tag k="osmc:symbol" v="red:white:red_bar"/>
  <tag k="route" v="hiking"/>
  <tag k="surface" v="ground"/>
  <tag k="type" v="route"/>
 </relation>
