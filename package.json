{
  "name": "mratkino-3d-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-region-data.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "build:standalone": "vite build --config vite.embed.config.js && node scripts/export_standalone.mjs",
    "prepare:web": "python scripts/prepare_web_data.py && python scripts/prepare_winter_forest.py && python scripts/prepare_forest_instances.py",
    "test:unit": "node --test tests/*.test.js",
    "prepare:region": "node scripts/prepare-region-data.mjs",
    "test:explorer": "playwright test tests/explorer.spec.js",
    "test:landscape": "playwright test tests/landscape.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "maplibre-gl": "6.15.0",
    "pbf": "^4.0.1",
    "three": "0.180.0"
  }
}
